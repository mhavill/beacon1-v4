/**
 * secrets.h.template
 *
 * Copy this file to secrets.h and fill in your WiFi credentials.
 * secrets.h is in .gitignore and will never be committed to git.
 *
 * For beacons deployed to team members:
 *   Set all values to empty strings "".
 *   The beacon will start in provisioning mode and the team member
 *   configures their own WiFi via the ChromaVertex-Setup hotspot.
 *
 * For developer beacons:
 *   Fill in your home/office WiFi so the beacon connects automatically
 *   without needing provisioning on every flash.
 *
 * Usage:
 *   cp main/secrets.h.template main/secrets.h
 *   # then edit main/secrets.h with your credentials
 */

#pragma once

// Primary network (home/office)
#define WIFI_SSID_HOME    ""
#define WIFI_PASS_HOME    ""

// Secondary network (mobile hotspot)
#define WIFI_SSID_MOBILE  ""
#define WIFI_PASS_MOBILE  ""

// Tertiary network (iPhone hotspot)
#define WIFI_SSID_IPHONE  ""
#define WIFI_PASS_IPHONE  ""
